{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./src",
    // tsup's dts step hardcodes `baseUrl: "."`, which the TS6 compiler API it
    // generates declarations with treats as a hard error. Nothing here sets it.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}
